# =====================================================================
#  ХРАНИЛИЩЕ — нужен РОВНО ОДИН вариант из двух
# =====================================================================

# --- Вариант A: Cloudflare R2 (используется на miterova.ru) ---
# Если заданы R2_ACCOUNT_ID + R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY,
# то используется R2, а Supabase игнорируется.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photos
# Необязательно. По умолчанию картинки раздаются через /api/img/
R2_PUBLIC_BASE_URL=

# --- Вариант B: Supabase Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PHOTOS_BUCKET=photos

# =====================================================================
#  ДОСТУП В АДМИНКУ
# =====================================================================
ADMIN_USER=alisa
# Сгенерировать:  node api/router.js hash "ваш-пароль"
ADMIN_PASSWORD_HASH=
# Сгенерировать:  node api/router.js secret
SESSION_SECRET=

# =====================================================================
#  ФОТОГРАФИИ (все параметры необязательные)
# =====================================================================
# Ограничений по РАЗРЕШЕНИЮ нет вообще — 100+ МП принимаются.

# Качество AVIF, 1..100. 90 — визуально неотличимо от оригинала.
AVIF_QUALITY=90

# Старательность кодека, 0..9. Больше = меньше файл, но сильно дольше.
# 2 — разумный компромисс. Ставьте 0, если загрузка кажется медленной.
AVIF_EFFORT=2

# Сжатие без потерь. НЕ ВКЛЮЧАЙТЕ на Vercel: файл растёт в ~7 раз,
# кодирование занимает минуты и функция падает по таймауту.
# AVIF_LOSSLESS=1

# Потолок размера загружаемого файла в байтах.
# На Vercel бесполезно ставить больше ~4 МБ: сама платформа режет на 4,5 МБ.
# MAX_UPLOAD_BYTES=4194304

# =====================================================================
#  ЛОКАЛЬНЫЙ ЗАПУСК — выставляется автоматически через npm run dev
# =====================================================================
# CMS_LOCAL=1
# CMS_LOCAL_DIR=./.local-cms
# PORT=3000

# --- Хранение оригиналов ---
# При прямой загрузке в R2 рядом с лёгкой веб-версией сохраняется
# исходный файл без единого пережатия (ключ вида cms/<uuid>.orig).
# 1 — хранить оригиналы (по умолчанию), 0 — не хранить и экономить место.
KEEP_ORIGINALS=1

# --- Прямая загрузка в R2 (необязательно) ---
# По умолчанию выключена: фото идут через сайт, настраивать в Cloudflare ничего не нужно.
# Включать только если нужно хранить исходники целиком И настроен CORS на бакете.
# DIRECT_UPLOAD=1
