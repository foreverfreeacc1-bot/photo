# ------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ------------------------------------------------------------------
# Public URL of your Supabase project, e.g. https://abcxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SERVER ONLY - never expose to the browser).
# Used for admin operations: inviting admins, storage cleanup, etc.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------
# Canonical public URL (used for metadata / invite redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Storage bucket name for photos (created by supabase/schema.sql).
NEXT_PUBLIC_PHOTOS_BUCKET=photos
