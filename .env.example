# ЭТИ ПЕРЕМЕННЫЕ ЗАДАЮТСЯ В VERCEL: Project → Settings → Environment Variables
# Файл .env в репозиторий НЕ коммитить (он в .gitignore). Это только шпаргалка.

# Supabase (Settings → API). ВАЖНО: старый service_role ключ скомпрометирован — сначала ротируйте его!
SUPABASE_URL=https://ваш-проект.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Бакет в Supabase Storage для фото и контента (должен быть Public)
PHOTOS_BUCKET=photos

# Логин администратора
ADMIN_USER=alisa

# Хэш пароля: сгенерируйте локально командой  node api/router.js hash "ВашПароль"
ADMIN_PASSWORD_HASH=

# Секрет подписи сессий: сгенерируйте командой  node api/router.js secret
# Необязательно: если не задать, сервер выведет секрет сам из ADMIN_PASSWORD_HASH
SESSION_SECRET=
